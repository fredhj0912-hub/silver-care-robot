# frontend/.env 템플릿. 이 파일을 .env로 복사한 뒤 값을 채운다.
# .env 자체는 .gitignore로 제외되어 있다 — 실제 키를 이 파일(.env.example)에 적지 말 것.
#
# ⚠️ VITE_* 값은 빌드 시점에 클라이언트 번들로 들어간다. 브라우저에서 그대로 읽히므로
#    비밀로 지켜야 하는 값(GEMINI_API_KEY, VAPID_PRIVATE_KEY, DATABASE_URL)은
#    절대 VITE_ 접두어로 넣지 않는다. 그것들은 backend/.env에만 둔다.
#
# ⚠️ 값을 바꾸면 npm run build를 다시 해야 반영된다. 이미 만들어진 dist/에는
#    옛 값이 박혀 있다.

# ── 백엔드 연결 ──────────────────────────────────────────────────────────────
# 비워 두는 것이 정상이다. 비어 있으면 API 호출이 상대 경로로 나가고,
# dev 서버(5173)는 vite.config.js의 프록시로 localhost:3001에 붙는다.
# EC2 배포도 백엔드가 프론트를 같은 오리진에서 서빙하므로 비워 둔다(PUBLIC_DIR).
# 백엔드가 다른 호스트에 있을 때만 채운다.
# VITE_API_URL=

# ── 백엔드와 반드시 일치해야 하는 값 2개 ─────────────────────────────────────
# backend/.env의 ROBOT_API_KEY와 같은 값. 다르면 모든 /api/* 호출이 401로 막혀
# 앱이 백지로 뜬다. (이 키는 번들에 들어가므로 진짜 인증이 아니다 — TODO.md 백로그의
# "보호자 로그인" 항목 참고)
VITE_ROBOT_API_KEY=

# backend/.env의 VAPID_PUBLIC_KEY와 같은 값. 다르면 보호자 앱의 푸시 구독이 실패한다.
# npx web-push generate-vapid-keys 로 발급한 쌍 중 공개키 쪽이다.
VITE_VAPID_PUBLIC_KEY=

# ── 음성 인식 (STT) ─────────────────────────────────────────────────────────
# 'server' (기본) | 'browser'
#
#  server   마이크를 직접 녹음해 백엔드(POST /api/stt)로 보내고 Gemini가 받아쓴다.
#           **라즈베리파이는 반드시 이것이어야 한다** — 파이 OS 저장소의 Chromium은
#           구글 음성 키 없이 빌드돼 있어 브라우저 음성 인식이 매번 network 오류로
#           끝난다(2026-09-01 실측). ARM64용 정식 Chrome 빌드가 없어 브라우저 교체는
#           경로가 아니었다.
#  browser  Web Speech API. 개발 PC(윈도우 Chrome)에서만 동작하고, 녹음·업로드가
#           없어 지연이 짧다. Gemini 호출도 발생하지 않아 로컬 개발이 편하다.
#
# 최종 실행 환경이 파이이므로 기본값은 server다. 비워 두면 server로 동작한다.
# VITE_STT_MODE=server

# ── 카메라 모니터링 (선택, 기본 꺼짐) ────────────────────────────────────────
# 켜면 주기적으로 프레임을 찍어 /api/vision으로 보내고 Gemini Vision이 판정한다.
# 카메라 접근 동의와 API 비용이 함께 따르므로 명시적으로 켜야 한다.
# 'true' 문자열일 때만 켜진다.
# VITE_VISION_ENABLED=false
# VITE_VISION_INTERVAL_MS=15000              # 기본 15초
