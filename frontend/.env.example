# frontend/.env 템플릿. 이 파일을 .env로 복사한 뒤 값을 채운다.
# .env 자체는 .gitignore로 제외되어 있다 — 실제 키를 이 파일(.env.example)에 적지 말 것.
#
# ⚠️ VITE_* 값은 빌드 시점에 클라이언트 번들로 들어간다. 브라우저에서 그대로 읽히므로
#    비밀로 지켜야 하는 값(GEMINI_API_KEY, VAPID_PRIVATE_KEY, DATABASE_URL)은
#    절대 VITE_ 접두어로 넣지 않는다. 그것들은 backend/.env에만 둔다.
#
# ⚠️ 값을 바꾸면 npm run build를 다시 해야 반영된다. 이미 만들어진 dist/에는
#    옛 값이 박혀 있다.

# ── 백엔드 연결 ──────────────────────────────────────────────────────────────
# 비워 두는 것이 정상이다. 비어 있으면 API 호출이 상대 경로로 나가고,
# dev 서버(5173)는 vite.config.js의 프록시로 localhost:3001에 붙는다.
# EC2 배포도 백엔드가 프론트를 같은 오리진에서 서빙하므로 비워 둔다(PUBLIC_DIR).
# 백엔드가 다른 호스트에 있을 때만 채운다.
# VITE_API_URL=

# ── 백엔드와 반드시 일치해야 하는 값 2개 ─────────────────────────────────────
# backend/.env의 ROBOT_API_KEY와 같은 값. 다르면 모든 /api/* 호출이 401로 막혀
# 앱이 백지로 뜬다. (이 키는 번들에 들어가므로 진짜 인증이 아니다 — TODO.md 백로그의
# "보호자 로그인" 항목 참고)
VITE_ROBOT_API_KEY=

# backend/.env의 VAPID_PUBLIC_KEY와 같은 값. 다르면 보호자 앱의 푸시 구독이 실패한다.
# npx web-push generate-vapid-keys 로 발급한 쌍 중 공개키 쪽이다.
VITE_VAPID_PUBLIC_KEY=

# ── 음성 인식 (STT) ─────────────────────────────────────────────────────────
# 'server' (기본) | 'browser'
#
#  server   마이크를 직접 녹음해 백엔드(POST /api/stt)로 보내고 Gemini가 받아쓴다.
#           **라즈베리파이는 반드시 이것이어야 한다** — 파이 OS 저장소의 Chromium은
#           구글 음성 키 없이 빌드돼 있어 브라우저 음성 인식이 매번 network 오류로
#           끝난다(2026-09-01 실측). ARM64용 정식 Chrome 빌드가 없어 브라우저 교체는
#           경로가 아니었다.
#  browser  Web Speech API. 개발 PC(윈도우 Chrome)에서만 동작하고, 녹음·업로드가
#           없어 지연이 짧다. Gemini 호출도 발생하지 않아 로컬 개발이 편하다.
#
# 최종 실행 환경이 파이이므로 기본값은 server다. 비워 두면 server로 동작한다.
# VITE_STT_MODE=server

# ── 마이크를 언제 여는가 ──────────────────────────────────────────────────────
#  ptt     (기본) 화면의 큰 버튼을 눌러야 한 발화만큼 열린다.
#  always  상시 청취. **방 안의 모든 소리가 받아쓰기 1건**이 된다 —
#          웨이크워드 판정이 받아쓰기 뒤라 게이트가 닫혀 있어도 이미 지불된 뒤다.
#          2026-09-02 파이에서 한 시간에 100건을 이렇게 태웠다.
#
# ⚠️ ptt 는 **음성 응급 경로를 없앤다** — 마이크가 닫혀 있으면 "살려줘"가 닿지 않는다.
#    남는 것은 화면의 SOS 버튼이다(낙상 감지가 들어오기 전까지).
#
# 기기별로 다르게 하려면 URL 이 이긴다: ?mic=always / ?mic=ptt
# VITE_MIC_MODE=ptt

# ── 카메라 모니터링 (선택, 기본 꺼짐) ────────────────────────────────────────
# 켜면 주기적으로 프레임을 찍어 /api/vision으로 보내고 Gemini Vision이 판정한다.
# 카메라 접근 동의와 API 비용이 함께 따르므로 명시적으로 켜야 한다.
# 'true' 문자열일 때만 켜진다.
# VITE_VISION_ENABLED=false
# VITE_VISION_INTERVAL_MS=15000              # 기본 15초
#
# ⚠️ Vision 은 프레임마다 Gemini 를 부르고, 그 통은 **대화·받아쓰기와 같은 하루 40건**이다.
#    15초 간격이면 시간당 240건 — 10분 만에 하루치가 사라지고 대화까지 같이 죽는다.
#    방 안을 보는 것만이 목적이면 아래 스냅샷 경로를 쓸 것.

# ── 카메라 스냅샷 (분석 없이 사진만, 기본 꺼짐) ──────────────────────────────
# 주기적으로 사진을 찍어 POST /api/snapshots 로 올린다. 보호자 앱의 "방 안 모습"이
# 이걸 본다. **Gemini 를 한 번도 부르지 않아 할당량을 안 쓴다.**
#
# ⚠️ **켜는 스위치는 여기가 아니라 URL 의 `?snapshot=1` 이다.** 이 값은 빌드에 박혀서
#    EC2 가 서빙하는 페이지를 연 **모든** 브라우저가 자기 웹캠으로 찍게 만든다 —
#    노트북에서 키오스크를 열어 본 순간 보호자 화면에 방 안 사진과 노트북 웹캠
#    사진이 섞인다. 파이만 찍게 하려면 파이의 ~/.config/hyodol/kiosk.env 에
#    KIOSK_SNAPSHOT=1 을 넣는다(kiosk.sh 가 주소에 ?snapshot=1 을 붙인다).
#    아래 값은 로컬 개발에서 매번 파라미터를 치기 싫을 때만 쓴다. `?snapshot=0` 이 이긴다.
#
# VITE_VISION_ENABLED=true 이면 그쪽이 이긴다 — 카메라는 하나이고 분석 경로도 사진을 남긴다.
# 보관 개수는 백엔드의 SNAPSHOT_KEEP 이 정한다(기본 200장, 오래된 것부터 삭제).
# VITE_SNAPSHOT_ENABLED=false
# VITE_SNAPSHOT_INTERVAL_MS=30000            # 기본 30초

# ── 온디바이스 웨이크워드 모델 (관측용, 기본은 로컬 파일) ────────────────────
# vosk-browser 가 받아 갈 gzip tar 아카이브 주소. 비워 두면
# /models/vosk-model-small-ko-0.22.tar.gz (frontend/public/models/) 를 본다.
#
# **모델 파일은 레포에 없다** — 87MB 라 .gitignore 로 막았다. 각자 한 번 만든다:
#   curl -O https://alphacephei.com/vosk/models/vosk-model-small-ko-0.22.zip
#   unzip vosk-model-small-ko-0.22.zip
#   tar -czf vosk-model-small-ko-0.22.tar.gz vosk-model-small-ko-0.22
#   mv vosk-model-small-ko-0.22.tar.gz frontend/public/models/
# (alphacephei 는 zip 으로 주는데 vosk-browser 는 gzip tar 만 받는다)
#
# ⚠️ **파이에 올릴 때는 S3 같은 고정 주소를 넣는다.** 터널 주소는 재시작마다 바뀌어
#    브라우저 기준 다른 사이트가 되고, 그때마다 82MB 를 처음부터 다시 받는다.
#    고정 오리진에 두면 캐시가 살아남는다(docs/plan-wake-word.md 관문 ③).
# VITE_WAKE_MODEL_URL=

# 웨이크워드 자체를 켜는 스위치는 여기가 아니라 **URL 의 ?wake=1** 이다(관측 전용).
#   ?wake=1     문법 제한 Vosk 로 관측. 좌하단 오버레이에 놓침/오인식 카운터가 뜬다
#   ?wake=free  자유 발화 Vosk — 문법 제한이 실제로 도움이 되는지 비교용
# 둘 다 **업로드를 강제로 막는다**(dryRun) — 관문 ② 측정에 할당량이 한 건도 안 든다.
