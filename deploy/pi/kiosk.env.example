# 파이 키오스크 설정 예시.
#
# 이 파일을 파이의 ~/.config/hyodol/kiosk.env 로 복사해서 채운다.
#   mkdir -p ~/.config/hyodol
#   cp kiosk.env.example ~/.config/hyodol/kiosk.env && chmod 600 ~/.config/hyodol/kiosk.env
#
# ⚠️ 값을 채운 파일을 레포에 커밋하지 않는다. 이 레포는 공개이고, 터널 주소는 사실상
#    접근 토큰이다(ACCESS.html을 gitignore하는 것과 같은 이유).

# 백엔드(EC2) 주소. **반드시 https:// 여야 한다.**
# http로 열면 보안 컨텍스트가 아니어서 음성 인식·카메라·서비스워커가 전부 죽는다.
# EC2를 재시작할 때마다 터널 주소가 바뀐다:
#   ~/silver-care-robot/deploy/pi/set-url.sh https://<새 주소>.trycloudflare.com
KIOSK_URL=

# preflight.sh가 /api/status 를 확인할 때만 쓴다.
# 키오스크 실행 자체에는 필요 없다 — 키는 이미 프론트엔드 번들에 들어 있다.
ROBOT_API_KEY=

# 화면 방향. 비워 두면 OS 설정 그대로 둔다(기존 동작).
# 09-01에 파이 화면이 세로로 떠서 생긴 항목이다 — 키오스크는 800×480 **가로** 전제다.
# 값은 wlr-randr 의 transform: normal | 90 | 180 | 270
# 맞는 값은 직접 돌려 보며 찾는다:
#   ~/silver-care-robot/deploy/pi/set-rotation.sh 90
# ⚠️ 터치스크린이면 화면을 돌린 뒤 **터치가 맞는 자리에 눌리는지** 반드시 확인할 것.
KIOSK_ROTATE=

# 출력이 여러 개일 때만 쓴다. 비워 두면 wlr-randr 의 첫 번째 출력을 쓴다.
# KIOSK_ROTATE_OUTPUT=
