# backend/.env 템플릿. 이 파일을 .env로 복사한 뒤 값을 채운다.
# .env 자체는 .gitignore로 제외되어 있다 — 실제 키를 이 파일(.env.example)에 적지 말 것.

# ── Gemini ───────────────────────────────────────────────────────────────────
# https://aistudio.google.com/ 에서 무료 발급. 미설정이면 mock 대화로 동작한다.
# 대화·비전 분석 모두 Gemini를 쓴다 (대회 AWS 계정은 Bedrock 등 클라우드 AI를 지원하지 않음).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash              # 기본값. 3.7-flash는 503이 잦아 기본값으로 쓰지 않는다
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ── S3 (스냅샷 저장소) ────────────────────────────────────────────────────────
# 'local'(기본, backend/data/snapshots) | 's3'
# ⚠️ 대회(한이음 드림업) 제공 AWS 계정은 Access Key 발급이 금지되어 있다.
#    AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 는 여기 넣지 않는다 — 발급 자체가 안 된다.
#    인증은 IAM Role로만 가능하므로, EC2 인스턴스에 SafeInstanceProfile-{username}을
#    붙이면 아래 값들만으로 SDK가 자동 인증한다. 로컬에서는 s3 모드 인증이 불가능하다.
#    (docs/deploy-ec2-aws-test.md 참고)
SNAPSHOT_STORAGE=local
# AWS_REGION=us-west-2
# S3_BUCKET=your-username-hyodol-snapshots   # 버킷 이름은 반드시 본인 username으로 시작

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
# sqlite(기본, backend/data/hyodol.sqlite) | pg(RDS PostgreSQL)
# ⚠️ S3와 달리 RDS는 사용자/비밀번호 인증이라 Access Key 금지 제약에 걸리지 않는다.
#    로컬에서도 그대로 연결된다 — 붙이기 전에 npm run verify-rds 로 먼저 확인할 것.
#    (테스트 스위트는 SQLite로 돌기 때문에 pg 경로의 실검증 수단은 그 스크립트뿐이다)
DB_DRIVER=sqlite
# DATABASE_URL=postgres://사용자:비밀번호@호스트.rds.amazonaws.com:5432/silvercare
# DATABASE_SSL=0                             # 로컬 PostgreSQL로 시험할 때만. RDS는 SSL 필수

# ── 서버 ─────────────────────────────────────────────────────────────────────
PORT=3001

# 프론트엔드 빌드를 백엔드가 같은 오리진에서 서빙할 디렉터리 (EC2 배포 전용).
# 설정하면 / 는 키오스크, /guardian/* 는 보호자 앱이 되고 상태 페이지는 사라진다.
# 로컬 개발에서는 비워 둔다 — Vite dev 서버(5173)가 화면을 맡고 /api를 프록시한다.
# ⚠️ VITE_* 값은 빌드 시점에 번들에 박히므로 frontend/.env를 먼저 쓰고 build 해야 한다.
# PUBLIC_DIR=/home/ec2-user/silver-care-robot/frontend/dist

# 모든 /api/* 요청의 'x-api-key' 헤더에 요구되는 공유 비밀키.
# 미설정이면 같은 네트워크의 누구나 SOS/카메라/원격조종 API를 호출할 수 있다.
# frontend/.env의 VITE_ROBOT_API_KEY와 같은 값이어야 한다.
ROBOT_API_KEY=

# ── Web Push (보호자 응급 알림) ──────────────────────────────────────────────
# npx web-push generate-vapid-keys 로 발급. 셋 다 있어야 푸시가 동작한다.
# VAPID_PUBLIC_KEY는 frontend/.env의 VITE_VAPID_PUBLIC_KEY와 같은 값이어야 한다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── TTS (선택) ───────────────────────────────────────────────────────────────
# 'browser'(기본, 지연 0) | 'gemini'(약 4.9초, 느림) | 'cloud'(Cloud TTS, 콘솔에서 API 활성화 필요)
# TTS_PROVIDER=browser
# TTS_VOICE=Leda

# ── 감지/알림 튜닝 (선택) ────────────────────────────────────────────────────
# DETECTION_THRESHOLD=0.7                    # 이 값 미만 신뢰도는 기록만 하고 알림은 안 올린다
# ALERT_COOLDOWN_MS=600000                   # 같은 유형 알림 연속 발생 억제 (10분)
